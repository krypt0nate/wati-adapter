{
  "name": "wati-adapter",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krypt0nate/wati-adapter.git"
  },
  "homepage": "https://github.com/krypt0nate/wati-adapter#readme",
  "bugs": {
    "url": "https://github.com/krypt0nate/wati-adapter/issues"
  },
  "license": "MIT",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo run lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "konsistent": "konsistent --config-path .github/konsistent.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@changesets/cli": "^2.29.8",
    "@vitest/coverage-v8": "^4.0.18",
    "konsistent": "0.0.1-alpha.24",
    "tsx": "^4.23.5",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3",
    "ultracite": "7.2.4",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ]
